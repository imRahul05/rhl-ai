{
  "name": "@rhl-ai/cli",
  "version": "0.1.0",
  "description": "Command-line interface for RHL AI tools, skills, and scaffolding",
  "type": "module",
  "bin": {
    "rhl": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rhl-ai/scaffold": "workspace:*",
    "@rhl-ai/skills": "workspace:*",
    "@rhl-ai/utils": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
